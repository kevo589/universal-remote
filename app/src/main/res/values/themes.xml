<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- "DayNight" is a Material Components / AppCompat concept, not a plain framework one —
         android:Theme.Material has no DayNight variant. This is only the brief pre-Compose
         window theme (status bar, launch background); UniversalRemoteTheme (Compose) owns
         the actual light/dark color scheme once content renders. -->
    <style name="Theme.UniversalRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar" />
</resources>
